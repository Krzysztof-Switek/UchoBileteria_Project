{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\"",
            "timeout": 300,
            "statusMessage": "Budowanie kontekstu projektu (build_context.py)..."
          }
        ]
      }
    ]
  }
}
