{
  "name": "bileteria-ucho-assets",
  "private": true,
  "description": "Local Tailwind CSS build (UX-01: no CDN, no external requests on the buyer path).",
  "scripts": {
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/dist/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
